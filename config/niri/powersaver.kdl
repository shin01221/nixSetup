include "transparency.kdl"

layer-rule {
    match namespace="^wlr_which_key$"
    opacity 1.0
    background-effect {
        blur false
        xray false
    }
}

animations {
    workspace-switch {
        duration-ms 0
    }
    horizontal-view-movement {
        duration-ms 0
    }
    window-open {
        duration-ms 0
    }
    window-close {
        duration-ms 0
    }
}
