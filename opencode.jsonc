{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    // mcp-nixos exposes NixOS, nixpkgs, and Home Manager option search.
    // `uv` is declared in modules/packages/dev.nix; after a rebuild
    // `uvx` is used directly. Until then, fall back to running uv via Nix.
    "nixos": {
      "type": "local",
      "command": [
        "bash",
        "-lc",
        "if command -v uvx >/dev/null 2>&1; then exec uvx mcp-nixos; else exec nix run nixpkgs#uv -- tool run mcp-nixos; fi"
      ],
      "timeout": {
        "startup": 180000
      }
    }
  },
  "references": {
    "neolectron-nixfiles": {
      "repository": "neolectron/nixfiles",
      "description": "Reference NixOS config and OpenCode/Codex agent setup this repo's agent tooling is adapted from"
    },
    "home-manager": {
      "repository": "nix-community/home-manager",
      "description": "Home Manager option definitions and module patterns"
    },
    "nixvim": {
      "repository": "nix-community/nixvim",
      "description": "NixVim modules and options used by modules/dev/_nixvim"
    }
  }
}
