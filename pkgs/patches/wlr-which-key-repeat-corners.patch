+fn rounded_corner(
+    cairo_ctx: &cairo::Context,
+    center_x: f64,
+    center_y: f64,
+    radius: f64,
+    angle1: f64,
+    angle2: f64,
+) {
+    if radius > 0.0 {
+        cairo_ctx.arc(center_x, center_y, radius, angle1, angle2);
+    } else {
+        cairo_ctx.line_to(center_x, center_y);
+    }
+}
+
 fn exec(cmd: &str) {
     let mut proc = Command::new("sh");
     proc.args(["-c", cmd]);
